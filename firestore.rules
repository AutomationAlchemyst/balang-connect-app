rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public-readable collections with admin-only writes
    match /{collection}/{docId} {
      allow read: if collection in ['infaqSlots', 'blockedDates', 'flavors', 'packages', 'addons', 'promotions'];
      allow write: if request.auth != null && exists(/databases/$(database)/documents/admins/allowedUids) && request.auth.uid in get(/databases/$(database)/documents/admins/allowedUids).data.uids;
    }
    // Admin list collection - client access completely denied (managed via Console or Admin SDK)
    match /admins/{docId} {
      allow read, write: if false;
    }
  }
}
